# Attack Shark Gaming Mice - udev access rules
# Allows unprivileged user space access to bare-metal /dev/hidraw nodes
#
# Supported Devices:
#   - Attack Shark X8 Plus (Wired mode: 1d57:2124)
#   - Attack Shark X8 Plus (2.4G Wireless Dongle: 1d57:fa60)

KERNEL=="hidraw*", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="2124", MODE="0666", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1d57", ATTRS{idProduct}=="fa60", MODE="0666", TAG+="uaccess"
