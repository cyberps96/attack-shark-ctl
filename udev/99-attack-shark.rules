# Attack Shark Gaming Mice - udev access rules
# Allows unprivileged user space access to bare-metal /dev/hidraw nodes
#
# Supported Devices:
#   - Attack Shark Gaming Mice (All Models: X8 Plus, X3, X6, R1, etc.)
#   - Vendor ID: 1d57 (covers all 18 wired models and 2.4G wireless dongles)

KERNEL=="hidraw*", ATTRS{idVendor}=="1d57", MODE="0666", TAG+="uaccess"
